rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /studies/{studyId}/users/{userId}/{allPaths=**} {
      allow read, update, delete: if false;
      allow create: if request.auth.uid == userId;
    }
  }
}
