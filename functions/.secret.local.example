OPENAI_API_KEY=...
# The OpenAI-compatible endpoint the key belongs to. Stanford's gateway is the one Plainly deploys against;
# a key issued elsewhere needs the endpoint that issued it.
OPENAI_BASE_URL=https://aiapi-prod.stanford.edu/v1
# Voice sessions are minted with this pair when the key is set, and with the pair above otherwise. The key must be
# enabled for a realtime model and a transcription model, and the endpoint must serve the realtime paths.
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1
