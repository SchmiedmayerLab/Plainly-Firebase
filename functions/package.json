{
  "main": "lib/index.js",
  "scripts": {
    "lint": "eslint src test scripts",
    "lint:fix": "eslint src test scripts --fix",
    "lint:strict": "eslint src test scripts --max-warnings 0",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only auth,functions,firestore,storage",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --all --src src --exclude \"src/services/chat/chat-interceptor.ts\" --exclude \"src/services/chat/output-transform.ts\" --exclude \"src/services/chunking/chunk.ts\" --exclude \"src/services/chunking/text-extraction/document-metadata.ts\" --exclude \"src/services/chunking/text-extraction/text-extractor.ts\" --exclude \"src/services/context/context-store.ts\" --reporter=text --reporter=lcov --check-coverage --lines 40 --statements 40 --branches 70 --functions 80 tsx --test test/**/*.test.ts",
    "test:diff-coverage": "node scripts/check-diff-coverage.mjs",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/**/*.integration.ts",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "name": "functions",
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@genkit-ai/compat-oai": "^1.41.0",
    "@genkit-ai/firebase": "^1.41.0",
    "ajv": "^8.20.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "genkit": "^1.40.1",
    "openai": "^7.8.0",
    "pdf-lib": "^1.17.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "firebase": "^12.18.0",
    "globals": "^17.11.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5"
  },
  "private": true
}
